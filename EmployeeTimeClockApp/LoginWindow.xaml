<Window x:Class="EmployeeTimeClockApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login - Employee Time Clock"
        Height="250"
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F3F4F6">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="142.14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Please sign in"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,12"/>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="16"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Username -->
                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Username"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="UsernameTextBox"
                             Height="28"
                             Padding="4"/>
                </StackPanel>

                <!-- Password -->
                <StackPanel Grid.Row="1" Margin="0,4,0,8">
                    <TextBlock Text="Password"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PasswordBox"
                                 Height="28"
                                 Padding="4"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0">
                    <Button Content="Cancel"
                            Width="80"
                            Height="28"
                            Margin="0,0,8,0"
                            Click="CancelButton_Click"/>
                    <Button Content="Login"
                            Width="80"
                            Height="28"
                            Background="#2563EB"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Click="LoginButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="2"
                   Foreground="#DC2626"
                   Margin="0,8,0,0"
                   Text=""
                   HorizontalAlignment="Left"/>
    </Grid>
</Window>
