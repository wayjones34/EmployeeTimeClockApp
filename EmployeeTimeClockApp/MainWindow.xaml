<Window x:Class="EmployeeTimeClockApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Employee Time Clock"
        Height="450"
        Width="750"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header -->
                <RowDefinition Height="Auto"/>  <!-- Employee + actions -->
                <RowDefinition Height="Auto"/>  <!-- Today's entries -->
                <RowDefinition Height="Auto"/>  <!-- Weekly report -->
                <RowDefinition Height="Auto"/>  <!-- Footer -->
            </Grid.RowDefinitions>
            

            <!-- 🔹 HEADER BAR -->
            <Border Grid.Row="0"
                    Background="#1F2937"
                    Padding="12"
                    CornerRadius="8">
                <DockPanel>
                    
                    <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                        <TextBlock Text="Employee Time Clock"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Clock in / Clock out tracking"
                                   Foreground="#D1D5DB"
                                   FontSize="12"/>
                    </StackPanel>
                    
                    

                    <StackPanel Orientation="Vertical"
                                DockPanel.Dock="Right"
                                HorizontalAlignment="Right">
                        <TextBlock x:Name="CurrentDateText"
                                   Text="Tuesday, November 25, 2025"
                                   Foreground="#E5E7EB"
                                   FontSize="12"
                                   HorizontalAlignment="Right"/>
                        <TextBlock x:Name="CurrentTimeText"
                                   Text="10:45 AM"
                                   Foreground="#9CA3AF"
                                   FontSize="11"
                                   HorizontalAlignment="Right"/>
                        <TextBlock x:Name="LoggedInUserText"
           Text="Logged in as:"
           Foreground="#9CA3AF"
           FontSize="11"
           HorizontalAlignment="Right"/>

                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 🔹 EMPLOYEE + BUTTONS CARD -->
            <Border Grid.Row="1"
                    Margin="0,12,0,12"
                    Background="White"
                    CornerRadius="8"
                    Padding="12"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Select Employee"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,0,0,4"/>
                        <ComboBox x:Name="EmployeeComboBox"
                                  Height="28"
                                  DisplayMemberPath="FullName"
                                  SelectedValuePath="EmployeeId"
                                  IsEditable="False"
                                  Padding="4"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Badge Number (optional)"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,0,0,4"/>
                        <TextBox x:Name="BadgeTextBox"
                                 Height="28"
                                 Padding="4"
                                 HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom">
                        <Button x:Name="ClockInButton"
                                Content="Clock In"
                                Width="90"
                                Height="32"
                                Margin="0,0,8,0"
                                Click="ClockInButton_Click"
                                Background="#10B981"
                                Foreground="White"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"/>
                        <Button x:Name="ClockOutButton"
                                Content="Clock Out"
                                Width="90"
                                Height="32"
                                Click="ClockOutButton_Click"
                                Background="#EF4444"
                                Foreground="White"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 🔹 TODAY'S TIME ENTRIES -->
            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="8"
                    Padding="10"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Today's Time Entries"
                                   FontWeight="SemiBold"
                                   FontSize="14"/>

                        <TextBlock x:Name="TotalHoursText"
                                   Margin="16,0,0,0"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="#374151"
                                   Text="Total Hours Today: 0.00" />
                    </StackPanel>

                    <DataGrid x:Name="EntriesDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              Margin="0,4,0,0">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F3F4F6"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Clock In"
                                                Binding="{Binding ClockInTime, StringFormat=g}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Clock Out"
                                                Binding="{Binding ClockOutTime, StringFormat=g}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ✅ WEEKLY HOURS REPORT (NOW VISIBLE) -->
            <GroupBox Grid.Row="3" Header="Weekly Hours Report" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock x:Name="WeekLabel"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <DataGrid x:Name="WeeklyReportGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              Height="140"
                              Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Day" Binding="{Binding Day}" Width="*" />
                            <DataGridTextColumn Header="Hours" Binding="{Binding Hours, StringFormat=0.00}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Export CSV" Width="120" Margin="5" Click="ExportWeeklyCsv_Click"/>
                        <Button Content="Export PDF" Width="120" Margin="5" Click="ExportWeeklyPdf_Click"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- 🔹 FOOTER -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0">
                <TextBlock Text="Status:" FontWeight="SemiBold" Margin="0,0,4,0"/>
                <TextBlock x:Name="StatusText" Text="Ready." Foreground="#4B5563"/>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</Window>
