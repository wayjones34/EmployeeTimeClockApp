<Window x:Class="EmployeeTimeClockApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Employee Time Clock"
        Height="450"
        Width="750"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Employee + actions -->
            <RowDefinition Height="*"/>
            <!-- Data grid -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- 🔹 HEADER BAR -->
        <Border Grid.Row="0"
                Background="#1F2937"
                Padding="12"
                CornerRadius="8">
            <DockPanel>
                <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                    <TextBlock Text="Employee Time Clock"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"/>
                    <TextBlock Text="Clock in / Clock out tracking"
                               Foreground="#D1D5DB"
                               FontSize="12"/>
                </StackPanel>

                <StackPanel Orientation="Vertical"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right">
                    <TextBlock x:Name="CurrentDateText"
                               Text="Tuesday, November 25, 2025"
                               Foreground="#E5E7EB"
                               FontSize="12"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="CurrentTimeText"
                               Text="10:45 AM"
                               Foreground="#9CA3AF"
                               FontSize="11"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 🔹 EMPLOYEE + BUTTONS CARD -->
        <Border Grid.Row="1"
                Margin="0,12,0,12"
                Background="White"
                CornerRadius="8"
                Padding="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <!-- Employee info -->
                    <ColumnDefinition Width="2*"/>
                    <!-- Badge -->
                    <ColumnDefinition Width="2*"/>
                    <!-- Buttons -->
                </Grid.ColumnDefinitions>

                <!-- Employee selection -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Select Employee"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Margin="0,0,0,4"/>
                    <ComboBox x:Name="EmployeeComboBox"
                              Height="28"
                              DisplayMemberPath="FullName"
                              SelectedValuePath="EmployeeId"
                              IsEditable="False"
                              Padding="4"
                              />
                </StackPanel>

                <!-- Badge input (optional quick entry) -->
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Badge Number (optional)"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="BadgeTextBox"
         Height="28"
         Padding="4"
         HorizontalAlignment="Stretch"
/>

                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            >
                    <Button x:Name="ClockInButton"
                            Content="Clock In"
                            Width="90"
                            Height="32"
                            Margin="0,0,8,0"
                            Click="ClockInButton_Click"
                            Background="#10B981"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"/>
                    <Button x:Name="ClockOutButton"
                            Content="Clock Out"
                            Width="90"
                            Height="32"
                            Click="ClockOutButton_Click"
                            Background="#EF4444"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 🔹 DATA GRID CARD -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Padding="10"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <DockPanel>
                <TextBlock Text="Today's Time Entries"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Margin="0,0,0,8"
                           DockPanel.Dock="Top"/>

                <DataGrid x:Name="EntriesDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          Margin="0,4,0,0">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F3F4F6"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Clock In"
                                            Binding="{Binding ClockInTime, StringFormat=g}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Clock Out"
                                            Binding="{Binding ClockOutTime, StringFormat=g}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- 🔹 FOOTER -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <TextBlock Text="Status:"
                       FontWeight="SemiBold"
                       Margin="0,0,4,0"/>
            <TextBlock x:Name="StatusText"
                       Text="Ready."
                       Foreground="#4B5563"/>
        </StackPanel>
    </Grid>
</Window>
